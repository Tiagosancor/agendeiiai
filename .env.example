# Copie este arquivo para ".env" e ajuste os valores para o seu ambiente.
# Configuração 100% por variáveis de ambiente (seção 8.5.2) — nada de segredo aqui,
# só os nomes e valores de exemplo para desenvolvimento local com docker-compose.

# ---------------------------------------------------------------------------
# Banco de dados (PostgreSQL)
# ---------------------------------------------------------------------------
POSTGRES_USER=plataforma
POSTGRES_PASSWORD=plataforma_dev
POSTGRES_DB=plataforma
# Porta exposta no host. 5434 por padrão para não colidir com outros Postgres locais
# (a 5432 e a 5433 já podem estar ocupadas por outros projetos na máquina).
POSTGRES_PORTA_HOST=5434

# ---------------------------------------------------------------------------
# API (backend)
# ---------------------------------------------------------------------------
ASPNETCORE_ENVIRONMENT=Development
API_PORTA_HOST=5080

# ---------------------------------------------------------------------------
# Marca (white-label — seção 5). Nunca codifique o nome do produto; só configuração.
# ---------------------------------------------------------------------------
MARCA_NOME_PRODUTO=Agendeiiai
MARCA_DOMINIO=agendeiiai.localhost
MARCA_EMAIL_REMETENTE=nao-responda@agendeiiai.localhost
# Usados para montar os links de cancelar/remarcar nos e-mails (seção 6.3). Em produção,
# deixe MARCA_PORTA_URL_PUBLICA vazia (a porta padrão do esquema já resolve).
MARCA_ESQUEMA_URL_PUBLICA=http
MARCA_PORTA_URL_PUBLICA=3000

# ---------------------------------------------------------------------------
# Segurança (seção 4 / 8.4) — segredos de verdade, gere os seus:
#   JWT_CHAVE_SECRETA: openssl rand -base64 64
#   CPF_CHAVE_BASE64:  openssl rand -base64 32
# Trocar CPF_CHAVE_BASE64 depois de já existir CPF cifrado com a chave antiga exige
# rotação de chave (seção 8.5.4) — ainda não implementada; troque CPF_CHAVE_ID junto se
# algum dia isso for feito, senão os CPFs antigos ficam ilegíveis.
# ---------------------------------------------------------------------------
JWT_CHAVE_SECRETA=
JWT_EMISSOR=plataforma-dev
JWT_AUDIENCIA=plataforma-painel-dev
CPF_CHAVE_ID=dev-v1
CPF_CHAVE_BASE64=
# Pimenta do hash do código de confirmação (seção 8.1.2) — nunca o código em si. Gere:
#   openssl rand -base64 32
VERIFICACAO_CHAVE_HMAC=

# ---------------------------------------------------------------------------
# Backup (seção 8.5.7) — scripts/backup.sh e scripts/restore.sh. Gere a sua:
#   openssl rand -base64 32
# BACKUP_S3_BUCKET/BACKUP_S3_ENDPOINT são opcionais — sem eles, o backup fica só local.
# ---------------------------------------------------------------------------
BACKUP_CHAVE_CRIPTOGRAFIA=
BACKUP_RETENCAO_DIAS=30
# BACKUP_S3_BUCKET=
# BACKUP_S3_ENDPOINT=

# ---------------------------------------------------------------------------
# Frontend (Next.js)
# ---------------------------------------------------------------------------
FRONTEND_PORTA_HOST=3000
# Lida em runtime por middleware/server components (sem prefixo NEXT_PUBLIC_, por isso
# não precisa estar disponível no build da imagem — ver docs/decisoes.md). Dentro do
# docker-compose é o nome do serviço; fora dele, aponte para onde a API estiver.
API_URL_INTERNA=http://api:8080
# Endereço que o NAVEGADOR usa para chamar a API — embutido no bundle em tempo de build
# (NEXT_PUBLIC_*), então mudar isso exige `docker compose build frontend` de novo.
NEXT_PUBLIC_API_URL=http://localhost:5080

# ---------------------------------------------------------------------------
# E-mail (IEmailSender) — decidido na Sprint 0: Resend. Sem EMAIL_PROVEDOR, usa o
# provedor Fake (só loga, não envia de verdade) — é o padrão em dev/testes.
# ---------------------------------------------------------------------------
# EMAIL_PROVEDOR=Resend
# RESEND_API_KEY=

# ---------------------------------------------------------------------------
# Assinatura do negócio — pagamento manual enquanto não há gateway (seção 7).
# Aparecem no botão "Assinar agora" do painel. WhatsApp só dígitos, com DDI.
# Em produção (Railway): Cobranca__ChavePix / Cobranca__WhatsAppContato.
# O mesmo WhatsApp vira CONTATO_WHATSAPP no frontend ("Fale com a gente" do site) — em
# produção (Vercel), defina CONTATO_WHATSAPP lá também.
# ---------------------------------------------------------------------------
COBRANCA_CHAVE_PIX=
COBRANCA_WHATSAPP_CONTATO=

# ---------------------------------------------------------------------------
# WhatsApp (IMensageriaWhatsApp) — API Cloud da Meta (Sprint 3). Sem WHATSAPP_PROVEDOR,
# usa o provedor Fake. Depende do cadastro pendente na Meta (seção 12) — sem as duas
# variáveis abaixo, o WHATSAPP_PROVEDOR=Oficial falha rápido na inicialização.
# ---------------------------------------------------------------------------
# WHATSAPP_PROVEDOR=Oficial
# WHATSAPP_TOKEN_ACESSO=
# WHATSAPP_ID_NUMERO_TELEFONE=
# WhatsApp:PermitirNaoOficial — só "true" para usar o provedor EvolutionApi (não oficial: viola
# os termos do WhatsApp e pode levar ao banimento do número; ver seção 4 da especificação).
WHATSAPP__PERMITIRNAOOFICIAL=false

# ---------------------------------------------------------------------------
# Evolution API (WhatsApp não oficial). Em dev: docker compose --profile whatsapp up -d
# e depois WHATSAPP_PROVEDOR=EvolutionApi + WHATSAPP__PERMITIRNAOOFICIAL=true.
# Chave e segredo: openssl rand -hex 24 (cada um o seu). Nunca commitar os valores.
# O e-mail do código sai sempre em paralelo — o WhatsApp nunca é o único canal.
# ---------------------------------------------------------------------------
# EVOLUTION_CHAVE_API=
# EVOLUTION_SEGREDO_WEBHOOK=
# EVOLUTION_NOME_INSTANCIA=agendeiiai-dev
# EVOLUTION_URL_BASE=http://evolution:8080
# EVOLUTION_PORTA_HOST=8081

# ---------------------------------------------------------------------------
# Agente de WhatsApp (Fase 1) — instância por negócio, webhook por instância. Em produção (Railway):
# Evolution__BaseUrl, Evolution__ApiKey, Whatsapp__WebhookSecret, Whatsapp__UrlPublicaApi, Redis__ConnectionString.
# Segredo: openssl rand -hex 24 (16+ caracteres). Nunca commitar os valores.
# NÃO ligue MESSAGES_UPSERT no webhook GLOBAL da Evolution: o agente usa o webhook por instância.
# ---------------------------------------------------------------------------
# AGENTE_EVOLUTION_URL_BASE=http://evolution:8080
# AGENTE_EVOLUTION_CHAVE_API=        # a mesma AUTHENTICATION_API_KEY da Evolution
# AGENTE_WEBHOOK_SEGREDO=
# AGENTE_URL_PUBLICA_API=http://api:8080   # URL da API que a Evolution alcança
# REDIS_CONNECTION_STRING=redis:6379       # vazio = sem Redis (só o índice único do banco)

# ---------------------------------------------------------------------------
# Agente de WhatsApp (Fase 2) — IA de consulta (somente leitura). Em produção (Railway): Ai__Provider,
# Ai__Gemini__ApiKey, Ai__Gemini__Model, Ai__NegociosHabilitados, Ai__Limite*, Ai__CotaMensalTokensPorNegocio.
# Provider: Eco (padrão, comportamento da Fase 1) | Gemini | Desligado (salva a mensagem e não responde).
# Gemini sem chave falha na subida. NUNCA commite a chave. Deixe Eco no dev local e no e2e.
# NEGOCIOS_HABILITADOS: Guids separados por vírgula (piloto); vazio = todos os negócios.
# Antes de ligar Gemini em produção: ver docs/deploy.md (política de privacidade; em produção, chave com faturamento ligado).
# ---------------------------------------------------------------------------
# AI_PROVIDER=Eco
# AI_GEMINI_API_KEY=
# AI_GEMINI_MODEL=gemini-2.5-flash-lite
# AI_NEGOCIOS_HABILITADOS=
# AI_LIMITE_MENSAGENS_TELEFONE_HORA=15
# AI_LIMITE_MENSAGENS_TELEFONE_DIA=45
# AI_LIMITE_CHAMADAS_NEGOCIO_DIA=250
# AI_COTA_MENSAL_TOKENS=1500000
# AI_GEMINI_TIMEOUT_SEGUNDOS=15
# AI_TEMPO_MAXIMO_PROCESSAMENTO_SEGUNDOS=40
# AI_MAX_MENSAGENS_HISTORICO=20
# AI_DIAS_MAXIMOS_CONSULTA=60
# AI_GEMINI_URL_BASE=https://generativelanguage.googleapis.com/v1beta
# AI_MAX_ITERACOES_FERRAMENTAS=5
# AI_MAX_CHAMADAS_FERRAMENTA_ITERACAO=3
# AI_MAX_CARACTERES_MENSAGEM=1000
# AI_MAX_CARACTERES_HISTORICO=8000
# AI_MAX_TOKENS_SAIDA=512
# AI_MAX_CARACTERES_RESPOSTA=1000

# ---------------------------------------------------------------------------
# Armazenamento de arquivos (IArmazenamentoArquivos) — local em dev.
# ---------------------------------------------------------------------------
# ARMAZENAMENTO_PROVEDOR=Local

# ---------------------------------------------------------------------------
# Cloudflare Turnstile — captcha invisível no cadastro de negócio (seção 8.6.1).
# As duas vazias = captcha desligado (só rate limit). Chave do site vai para o front
# (runtime, não precisa rebuild); a secreta só para a API (Railway: Captcha__ChaveSecreta).
# ---------------------------------------------------------------------------
TURNSTILE_CHAVE_SITE=
TURNSTILE_CHAVE_SECRETA=
